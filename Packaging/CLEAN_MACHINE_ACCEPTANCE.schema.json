{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dmgAssetName": {
      "pattern": "^Activity-Radar-[0-9A-Za-z.-]+-macOS-universal2\\.dmg$",
      "type": "string"
    },
    "dmgSHA256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "records": {
      "contains": {
        "properties": {
          "macOSVersion": {
            "pattern": "^13\\."
          }
        },
        "required": [
          "macOSVersion"
        ]
      },
      "items": false,
      "maxContains": 2,
      "maxItems": 2,
      "minContains": 1,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/arm64Record"
        },
        {
          "$ref": "#/$defs/x86_64Record"
        }
      ],
      "type": "array"
    },
    "releaseCreatedAt": {
      "format": "date-time",
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "releaseID": {
      "minimum": 1,
      "type": "integer"
    },
    "releaseTag": {
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "dmgAssetName",
    "dmgSHA256",
    "records",
    "releaseCreatedAt",
    "releaseID",
    "releaseTag",
    "repository",
    "schemaVersion"
  ],
  "title": "Activity Radar clean-machine acceptance",
  "type": "object",
  "$defs": {
    "arm64Record": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "properties": {
            "architecture": {
              "const": "arm64"
            }
          }
        }
      ]
    },
    "baseRecord": {
      "additionalProperties": false,
      "properties": {
        "aboutReleaseIdentityVerified": {
          "const": true
        },
        "applicationCopiedToApplications": {
          "const": true
        },
        "applicationReplacementSucceeded": {
          "const": true
        },
        "architecture": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "browserDownloadQuarantineObserved": {
          "const": true
        },
        "checksumVerified": {
          "const": true
        },
        "dmgEjected": {
          "const": true
        },
        "dmgMountedReadOnly": {
          "const": true
        },
        "downloadedFromGitHubRelease": {
          "const": true
        },
        "gatekeeperLaunchSucceeded": {
          "const": true
        },
        "interfaceLanguageSwitchPersisted": {
          "const": true
        },
        "macOSBuild": {
          "pattern": "^[0-9]{2}[A-Z][A-Za-z0-9]{1,12}$",
          "type": "string"
        },
        "macOSVersion": {
          "maxLength": 8,
          "pattern": "^(?:1[3-9]|[2-9][0-9])\\.(?:0|[1-9][0-9]?)(?:\\.(?:0|[1-9][0-9]?))?$",
          "type": "string"
        },
        "machineDidNotBuildRelease": {
          "const": true
        },
        "menuBarItemVisible": {
          "const": true
        },
        "supportInformationContentFree": {
          "const": true
        },
        "syntheticCodexDeepLinkSucceeded": {
          "const": true
        },
        "testedAt": {
          "format": "date-time",
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "uninstallSucceeded": {
          "const": true
        },
        "wingmanCLIUnavailableFallbackVerified": {
          "const": true
        },
        "wingmanConsentPreviewVerified": {
          "const": true
        },
        "wingmanRemoteReviewSucceeded": {
          "const": true
        }
      },
      "required": [
        "aboutReleaseIdentityVerified",
        "applicationCopiedToApplications",
        "applicationReplacementSucceeded",
        "architecture",
        "browserDownloadQuarantineObserved",
        "checksumVerified",
        "dmgEjected",
        "dmgMountedReadOnly",
        "downloadedFromGitHubRelease",
        "gatekeeperLaunchSucceeded",
        "interfaceLanguageSwitchPersisted",
        "macOSBuild",
        "macOSVersion",
        "machineDidNotBuildRelease",
        "menuBarItemVisible",
        "supportInformationContentFree",
        "syntheticCodexDeepLinkSucceeded",
        "testedAt",
        "uninstallSucceeded",
        "wingmanCLIUnavailableFallbackVerified",
        "wingmanConsentPreviewVerified",
        "wingmanRemoteReviewSucceeded"
      ],
      "type": "object"
    },
    "x86_64Record": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRecord"
        },
        {
          "properties": {
            "architecture": {
              "const": "x86_64"
            }
          }
        }
      ]
    }
  }
}
